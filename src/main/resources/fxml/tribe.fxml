<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="gameTribe" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0" styleClass="texture" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mesos.am30.client.gui.TribeGui">
    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" layoutX="10.0" layoutY="10.0"
                maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
                prefWidth="600.0" style="-fx-background: transparent; -fx-background-color: transparent;"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">
        <AnchorPane stylesheets="@../css/style.css">
            <VBox fx:id="box" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="20.0"
                  AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                  AnchorPane.topAnchor="0.0">
                <HBox fx:id="title" alignment="CENTER">
                    <ImageView fx:id="totem" fitHeight="100.0" fitWidth="30.0" pickOnBounds="true"
                               preserveRatio="true">
                        <HBox.margin>
                            <Insets right="20.0"/>
                        </HBox.margin>
                        <Image url="@../icons/player1.png"/>
                    </ImageView>
                    <Label fx:id="name"
                           style="-fx-font-size: 30; -fx-text-fill: #000000; -fx-background-color: #FFFFFF; -fx-background-radius: 30;"
                           styleClass="just-font" stylesheets="@../css/style.css" text="PLAYER"
                           textFill="WHITE">
                        <padding>
                            <Insets left="25.0" right="20.0"/>
                        </padding>
                    </Label>
                    <Label style="-fx-font-size: 30;" styleClass="just-font"
                           stylesheets="@../css/style.css" text="'S TRIBE:" textFill="WHITE"/>
                </HBox>
            </VBox>
        </AnchorPane>
    </ScrollPane>
    <VBox alignment="CENTER" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <Button mnemonicParsing="false" onAction="#back" styleClass="yellow_button" text="← BACK"/>
    </VBox>
</AnchorPane>
