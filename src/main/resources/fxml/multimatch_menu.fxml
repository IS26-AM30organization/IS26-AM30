<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
            prefWidth="600.0" styleClass="menu-background" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mesos.am30.client.gui.MMMGui">
    <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="5.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <Label fx:id="title" styleClass="title" stylesheets="@../css/style.css" text="MESOS"/>
        <Button fx:id="playButton" mnemonicParsing="false" onAction="#play" prefWidth="400.0"
                style="-fx-background-color: #ffbb2f; -fx-background-radius: 25; -fx-font-size: 18;"
                styleClass="yellow_button" text="PLAY"/>
        <ScrollPane fx:id="existingLobbies" hbarPolicy="NEVER" maxWidth="400.0" prefWidth="400.0"
                    stylesheets="@../css/style.css">
            <VBox fx:id="lobbyList" prefWidth="400.0"
                  style="-fx-background-color: transparent; -fx-background-radius: 25;">
                <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="400.0"
                        styleClass="lobby_button" stylesheets="@../css/style.css" text="Button"/>
            </VBox>
        </ScrollPane>
        <HBox fx:id="newLobby" maxWidth="400.0" prefWidth="400.0" spacing="5.0">
            <Button maxWidth="50.0" minWidth="50.0" mnemonicParsing="false" onAction="#refresh"
                    prefHeight="70.0"
                    style="-fx-font-weight: bold; -fx-background-radius: 25; -fx-background-color: #654321; -fx-text-fill: white; -fx-font-size: 18;"
                    stylesheets="@../css/style.css" text="↻"/>
            <HBox style="-fx-background-color: #654321; -fx-background-radius: 25;">
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </padding>
                <TextField fx:id="newLobbyCode" prefHeight="40.0" prefWidth="300.0" promptText="NEW LOBBY"
                           style="-fx-background-radius: 20 0 0 20; -fx-background-color: white; -fx-font-family: &quot;Vagabundo Medium&quot;; -fx-font-size: 30;"/>
                <ChoiceBox fx:id="newLobbyPlayers" minWidth="100.0"
                           style="-fx-background-radius: 0 20 20 0; -fx-background-color: #ffbb2f; -fx-font-size: 29; -fx-font-family: &quot;Vagabundo Medium&quot;;"/>
                <Button minWidth="50.0" mnemonicParsing="false" onAction="#createLobby" prefHeight="60.0"
                        style="-fx-background-radius: 0 20 20 0; -fx-background-color: transparent; -fx-font-size: 15; -fx-text-fill: white;"
                        text="+"/>
            </HBox>
        </HBox>
        <HBox fx:id="nicknameBox" maxWidth="400.0"
              style="-fx-background-color: #ffbb2f; -fx-background-radius: 25;">
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </padding>
            <TextField fx:id="name" onAction="#answerNickname" prefHeight="40.0" prefWidth="400.0"
                       promptText="CHOOSE A NICKNAME"
                       style="-fx-background-radius: 20; -fx-background-color: white; -fx-font-family: ChristmasChalk;"/>
            <Button minWidth="50.0" mnemonicParsing="false" onAction="#answerNickname" prefHeight="40.0"
                    style="-fx-background-radius: 0 20 20 0; -fx-background-color: transparent; -fx-font-size: 15; -fx-text-fill: white;"
                    text="→"/>
        </HBox>
        <Label fx:id="connectedText" style="-fx-font-size: 20;" styleClass="simple_text"
               stylesheets="@../css/style.css" text="YOU'RE IN! WAITING FOR PLAYERS..."/>
        <Label fx:id="errorLabel" styleClass="simple_text" stylesheets="@../css/style.css" text="MARGARA!"
               visible="false"/>
    </VBox>
    <AnchorPane fx:id="loading" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #000000;"
                visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">
        <Label style="-fx-alignment: CENTER;" styleClass="just-font" stylesheets="@../css/style.css" text="LOADING..."
               textAlignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
    </AnchorPane>
</AnchorPane>
